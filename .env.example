# ────────────────────────────────────────────────────────────────
# 诗影工坊 · 环境配置（复制为 .env 后按需修改；不配置也能跑离线演示）
# ────────────────────────────────────────────────────────────────

# ── 文本工序：释义 / 背景 / 故事化文案 ──────────────────────────
# offline = 内置诗词数据 + 结构解析（离线可用；未知诗词为「纯朗诵版」）
# glm | deepseek | openai = 真实大模型（需 API Key，支持任意诗词）
SHIYING_TEXT_PROVIDER=offline
SHIYING_TEXT_API_KEY=
# （可选）覆盖默认端点与模型；glm 默认 https://open.bigmodel.cn/api/paas/v4 · glm-4-flash
# SHIYING_TEXT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# SHIYING_TEXT_MODEL=glm-4-flash

# ── 画面工序：分镜意境图 ────────────────────────────────────────
# svg      = 内置水墨分镜引擎（离线，0 成本，风格 100% 可控）
# seedream = AutoGLM 本地通道（本机 AutoClaw 运行时免 Key 出真图）
# cogview  = 智谱开放平台（需 API Key）
# openai   = OpenAI 兼容图像接口（需 API Key）
# siliconflow = 硅基流动（Kwai-Kolors/Kolors，OpenAI 兼容；需 API Key；实测已通）
# agnes   = Agnes AI（agnes-image-2.5-flash，OpenAI 兼容；国内站端点 api.agnes-ai.cn；
#           档位 size + ratio，自动 9:16 竖版；需国内站 API Key）
SHIYING_IMAGE_PROVIDER=svg
# 艺术风格（AI 出图通道生效，svg 离线引擎固定水墨）：
# ink 水墨 | gongbi 工笔重彩 | dunhuang 敦煌壁画 | ukiyoe 浮世绘
# oil 古典油画 | postimpression 后印象派 | impression 印象派
# shinkai 新海诚 | pixel 8-bit 像素
SHIYING_STYLE=ink
# 通用图像 Key；也可按通道单独配置（优先于通用 Key），多通道并存时互不串用：
SHIYING_IMAGE_API_KEY=
# SHIYING_IMAGE_API_KEY_AGNES=
# 免费档实际限流 1K=10 次/分、2K=5 次/分，客户端已按档位自动串行节流；
# 企业认证/Token Plan 用户可按自己的 RPM 上限覆盖：
# SHIYING_AGNES_RPM=20
# 动效工序（可选）：agnes = Agnes Video 2.5 Flash 关键分镜图生视频（与图像通道同 Key；
# 免费档 1 次/分，默认首/尾镜；SHIYING_MOTION_SCENES="1,3,6" 或 "all" 自定义）
# SHIYING_MOTION_PROVIDER=none
# SHIYING_MOTION_SCENES=
# SHIYING_MOTION_BASE_URL=
# SHIYING_MOTION_MODEL=agnes-video-2.5-flash
# （可选）
# SHIYING_IMAGE_BASE_URL=
# SHIYING_IMAGE_MODEL=

# ── 声音工序：朗诵配音 ──────────────────────────────────────────
# edge   = 微软 Edge 神经语音（真人感强、适合古诗朗诵；需 Python + edge-tts + 联网；推荐）
#         安装：pip install edge-tts
# sapi   = Windows 本机语音（离线兜底）
# openai = OpenAI 兼容语音合成接口（需 API Key）
# none   = 不做配音（静默成片）
SHIYING_VOICE_PROVIDER=edge
# 多 Python 环境下可指定含 edge-tts 的解释器：
# SHIYING_PYTHON=C:\Python314\python.exe
SHIYING_VOICE_API_KEY=
# （可选）
# SHIYING_VOICE_BASE_URL=
# SHIYING_VOICE_MODEL=tts-1

# ── 音乐与输出 ──────────────────────────────────────────────────
# synth = 内置合成（古琴 / 雨声，原创音源，无版权风险）；none = 无配乐
SHIYING_BGM_PROVIDER=synth
SHIYING_SIZE=1080x1920
